{
  "scan": {
    "exclude_dirs": ["tmp", "logs"],
    "exclude_globs": ["**/*.min.js", "**/fixtures/**"],
    "timeout_seconds": 90,
    "workers": null,
    "max_files": 50000,
    "max_depth": 40,
    "max_file_bytes": 2000000,
    "max_scan_seconds": 300
  },
  "ai": {
    "enabled": false,
    "provider": "openai",
    "model": "gpt-5.4-mini"
  },
  "web": {
    "base_url": "http://localhost:3000",
    "routes": ["/", "/login", "/dashboard"],
    "discover_routes": false,
    "clicks": [],
    "viewport": "desktop"
  },
  "quality_gate": {
    "fail_on": ["critical", "high"]
  }
}
